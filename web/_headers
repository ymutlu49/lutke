# Cloudflare Pages cache-control headers.
# index.html ve bootstrap dosyalarini cache'leme — her deploy fresh gelmeli.
# Hash'li static asset'ler default 4 saat cache (yeterli).

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/flutter_bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/version.json
  Cache-Control: public, max-age=0, must-revalidate

/favicon.png
  Cache-Control: public, max-age=86400

# Flutter ana bundle — her deploy degisik hash, cache'lenebilir ama
# kisa tut ki yeni deploy hizla yansisin
/main.dart.js
  Cache-Control: public, max-age=300, must-revalidate

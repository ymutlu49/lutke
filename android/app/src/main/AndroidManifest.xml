<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet — Firebase, sync, ses dosyaları -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Mikrofon — gelecek sürümlerde mobile speech-to-text için.
         İlk Play Store yayını için kaldırıldı (privacy policy süreci kısa
         tutulsun). Sonraki sürümde mobile konuşma pratiği eklenince
         tekrar açılır + Data Safety formuna eklenir. -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO"/> -->

    <!-- Bildirim/alarm izinleri kaldırıldı (Temmuz 2026): flutter_local_notifications
         pubspec'ten çıkarılmıştı, hiçbir bildirim servisi çalışmıyor. SCHEDULE_EXACT_ALARM
         Play politikasında yalnızca alarm/takvim uygulamalarına tanınıyor — gereksiz ret riski.
         Ön plan hizmeti (FGS) izinleri de kaldırıldı: uygulama arka planda medya çalmıyor,
         hiçbir <service> tanımı yok; FOREGROUND_SERVICE_MEDIA_PLAYBACK beyanı Play Console'da
         video kanıtı istiyordu. Bildirim özelliği eklenirse izinler + Console beyanlarıyla
         birlikte geri gelmeli. -->


    <application
        android:label="LÛTKE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Flutter embedding metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- Firebase Cloud Messaging (gelecekte) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lutke_daily"/>
    </application>

    <!-- Queries for URL launching -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- İngilizce TTS yedeği (flutter_tts) — Android 11+ paket görünürlüğü:
             bu sorgu olmadan cihazın TTS motoru bulunamaz, İngilizce sessiz kalır. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
